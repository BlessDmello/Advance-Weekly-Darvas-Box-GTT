{
  "name": "advanced-darvas-box",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "12.23.0"
  },
  "scripts": {
    "market-data:migrate-generations": "pnpm --filter @darvas/api... -r build && pnpm --filter @darvas/api market-data:migrate-generations",
    "market-data:prepare": "pnpm --filter @darvas/api... -r build && pnpm --filter @darvas/api market-data:prepare",
    "admin:bootstrap": "pnpm --filter @darvas/api... -r build && pnpm --filter @darvas/api admin:bootstrap",
    "predev": "pnpm build:packages",
    "dev": "concurrently --kill-others --names packages,web,api \"pnpm dev:packages\" \"pnpm --filter @darvas/web dev\" \"pnpm --filter @darvas/api dev\"",
    "dev:packages": "pnpm --filter \"./packages/*\" --parallel dev",
    "dev:web": "pnpm build:packages && pnpm --filter @darvas/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @darvas/api dev",
    "build:packages": "pnpm --filter \"./packages/*\" -r build",
    "db:ping": "pnpm --filter @darvas/database... -r build && pnpm --filter @darvas/database db:ping",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm build:packages && pnpm -r typecheck && tsc -p tsconfig.tools.json --noEmit",
    "test": "pnpm build:packages && vitest run",
    "test:watch": "pnpm build:packages && vitest",
    "test:e2e": "pnpm build:packages && pnpm --filter @darvas/api build && playwright test",
    "test:auth-server": "pnpm --filter @darvas/api exec tsx ../../tests/support/auth-api-server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "invitations:prepare": "pnpm --filter @darvas/api... -r build && pnpm --filter @darvas/api invitations:prepare"
  },
  "devDependencies": {
    "@darvas/contracts": "workspace:*",
    "@darvas/database": "workspace:*",
    "mongodb-memory-server-core": "11.4.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
