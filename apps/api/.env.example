NODE_ENV=development
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Replace placeholders only in the ignored apps/api/.env file.
# The scaffold does not connect automatically. Run pnpm db:ping explicitly.
MONGODB_URI=mongodb+srv://darvas_app_dev:YOUR_PASSWORD@YOUR_ATLAS_HOST/advanced_darvas_dev?retryWrites=true&w=majority
MONGODB_DB_NAME=advanced_darvas_dev
# Optional operator-reviewed market references. Empty approvals block confirmation.
# This contains reference fingerprints, not secrets, uploaded content or synthetic seeds.
# MARKET_REFERENCE_APPROVALS={"stocks":[],"calendars":[],"priceSources":[]}
# Optional locally; production auth requires a stable random 32-byte base64url secret.
# CSRF_SECRET=YOUR_RANDOM_CSRF_SIGNING_SECRET

# Future authentication and email only; do not enable features during scaffolding.
# SESSION_SECRET=<generate-a-strong-random-secret-before-authentication>
# RESEND_API_KEY=<server-only-api-key>
# RESEND_FROM_EMAIL=onboarding@resend.dev
# Development sender only; use an address on your verified domain in production.
# Import execution is explicit. Startup recovery is a separate opt-in.
IMPORT_RUNNER_ENABLED=false
IMPORT_RUNNER_RESUME_ON_STARTUP=false
IMPORT_RUNNER_CHUNK_ROWS=100
IMPORT_RUNNER_LEASE_MS=60000
IMPORT_RUNNER_SLICE_MS=20000
IMPORT_RUNNER_MAX_RECOVERIES=5
